[Unit]
Description=Ind-SADR redacted failure notification for %i
After=network-online.target
[Service]
Type=oneshot
ExecStart=%h/ind-sadr-rust-current/sadr-rs alert --event restart_loop --config %h/.config/ind-sadr/rust-paper.json
UMask=0077
NoNewPrivileges=true
TimeoutStartSec=60
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/ind-sadr
