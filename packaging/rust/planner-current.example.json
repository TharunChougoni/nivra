{
  "enabled": true,
  "provider": "xai_subscription",
  "model_led": true,
  "require_digest": true,
  "digest": {
    "enabled": true,
    "model_config": "/REVIEWED/APP_DIGEST_MODEL.json",
    "model_id": "gpt-6-luna",
    "transport": "openai_codex",
    "timeout_ms": 120000,
    "run_timeout_ms": 120000,
    "output_cap": 8000,
    "daily_call_budget": 400,
    "max_turns": 8,
    "max_read_tools": 24,
    "max_analysis_tools": 4
  },
  "orchestrator": {
    "enabled": true,
    "model": {
      "model_config": "/REVIEWED/APP_OWNER_MODEL.json",
      "model_id": "grok-4.7",
      "transport": "direct_oauth",
      "timeout_ms": 120000,
      "run_timeout_ms": 450000,
      "output_cap": 8000,
      "daily_call_budget": 200,
      "max_turns": 16,
      "max_read_tools": 32,
      "max_analysis_tools": 4,
      "tools": []
    },
    "daily_call_budget": 200,
    "sandbox": {
      "cpu_seconds": 30,
      "memory_mb": 512,
      "wall_ms": 60000,
      "network": false
    },
    "model_profiles": {
      "grok-owner": {
        "model_id": "grok-4.7",
        "transport": "direct_oauth",
        "model_config": "/REVIEWED/APP_OWNER_MODEL.json"
      },
      "sol-owner": {
        "model_id": "gpt-6.1-sol",
        "transport": "openai_codex",
        "model_config": "/REVIEWED/APP_SOL_MODEL.json"
      }
    },
    "admitted_models": [
      "default",
      "grok-owner",
      "sol-owner"
    ],
    "triggers": {
      "supervisor": {
        "enabled": true,
        "prompt": "${CONFIG_DIR}/prompts/supervisor.md",
        "daily_call_budget": 200,
        "min_interval_ms": 120000,
        "run_first": {
          "on_session_start": true,
          "on_resume": true,
          "on_change": true,
          "hold_luna_ms": 120000
        }
      }
    },
    "system_prompt": "${CONFIG_DIR}/prompts/orchestrator.md"
  },
  "events": {
    "enabled": true,
    "decision_start_minute": 555,
    "decision_timeout_ms": 450000,
    "policy": {
      "price_move_bps": 100,
      "volume_step_units": null,
      "gap_bps": 100,
      "proximity_bps": 100,
      "max_event_age_ms": 120000,
      "max_news_age_ms": 3600000,
      "max_instruments": 10000,
      "max_identities": 100000
    },
    "cooldown_ms": 0,
    "max_pending": 200,
    "news_file": null
  },
  "discovery": {
    "max_scan_age_ms": 180000,
    "max_prospects": 200,
    "digest_cadence_ms": 60000,
    "quote_freshness_ms": 2000,
    "screens": {
      "min_price": "10",
      "min_traded_value": "1000000",
      "min_circuit_distance_bps": "100"
    },
    "prefilter": {
      "enabled": false,
      "enter_rank": 100,
      "exit_rank": 150,
      "shortlist_size": 100,
      "market_relative_weight": 1.0,
      "rel_volume_tod_weight": 1.0,
      "vwap_distance_weight": 1.0,
      "spread_weight": 1.0
    },
    "feature_store": {
      "max_bars": 375,
      "min_instruments": 200
    },
    "market_feed": {
      "mode": "ltpc",
      "depth_mode": "rest",
      "max_connections": 1,
      "max_connect_addresses": 2,
      "connect_timeout_ms": 3000,
      "handshake_io_timeout_ms": 3000,
      "read_poll_timeout_ms": 250,
      "worker_idle_sleep_ms": 25,
      "shortlist_size": 40,
      "tick_ms": 2000,
      "stale_age_ms": 15000,
      "scan_activity_timeout_ms": 30000,
      "fresh_drop_alert_fraction": 0.5,
      "telemetry_window_ms": 60000,
      "metadata_poll_ms": 8000,
      "metadata_stale_ms": 300000,
      "metadata_preload_max_age_ms": 900000,
      "depth_poll_ms": 8000,
      "fallback_poll_ms": 8000,
      "rest_batch_size": 200,
      "reconnect_initial_ms": 1000,
      "reconnect_max_ms": 60000,
      "heartbeat_timeout_ms": 30000,
      "token_check_ms": 1000
    },
    "strategy_selection": {
      "enabled": false,
      "library_path": "",
      "evaluate_ms": 60000,
      "regime": {},
      "selector": {}
    },
    "shadow_scorer": {
      "enabled": false,
      "shortlist_only": false,
      "scorer_path": "",
      "params_path": "",
      "evaluate_ms": 60000,
      "top_n": 10
    }
  },
  "workspace": {
    "enabled": true,
    "root": "workspace",
    "max_file_bytes": 1048576,
    "max_write_bytes": 65536,
    "max_list_entries": 256,
    "run_allowlist": [
      "scanner/cost_aware_momentum.py"
    ],
    "install_allowlist": [],
    "cpu_seconds": 30,
    "memory_mb": 512,
    "wall_ms": 30000
  },
  "exit_policy": {
    "target": "review",
    "time": "review",
    "stop": "execute",
    "stop_backstop_bps": null,
    "on_halt": "freeze"
  }
}
