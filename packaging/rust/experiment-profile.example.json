{
  "version": 1,
  "prompts": {
    "objective": "prompts/objective.md",
    "digest": "prompts/data_owner.md"
  },
  "tools": {
    "scanner_limit": 40,
    "ranking_limit": 50,
    "history_limit": 5,
    "max_instrument_keys": 20
  },
  "cadence": {
    "idle_digest_interval_ms": 900000
  },
  "roles": {
    "digest": {
      "max_turns": 8,
      "max_read_tools": 16
    }
  },
  "supervisor": {
    "run_first": {
      "on_session_start": true,
      "on_resume": true,
      "on_change": true,
      "hold_luna_ms": 120000
    },
    "change_min_gap_ms": 600000
  },
  "directives": {}
}
