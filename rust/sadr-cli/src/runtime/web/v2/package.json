{
  "type": "module",
  "dependencies": {
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "name": "ind-sadr-workspace",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node --import tsx scripts/manifest.ts",
    "check:bundle": "node --import tsx scripts/manifest.ts --check",
    "test": "npm run typecheck && node --import tsx --test src/*.test.ts src/*.test.tsx && npm run check:bundle",
    "format": "prettier --write src scripts vite.config.ts tsconfig.json index.html",
    "format:check": "prettier --check src scripts vite.config.ts tsconfig.json index.html",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12"
  }
}
